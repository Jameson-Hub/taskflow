{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taskflow",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "taskflow",
      "database_id": "085e0f83-b826-4da3-b7c7-715242d3d16c",
      "migrations_dir": "migrations"
    }
  ],
  // Nightly: reset the demo workspace and delete workspaces unused for 30 days. 00:00 UTC.
  "triggers": { "crons": ["0 0 * * *"] },
  // Sign-up and login: 10 attempts per minute per IP.
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    // Opening read-only share links: loose enough for an office on one network.
    { "name": "VIEW_LIMITER", "namespace_id": "1003", "simple": { "limit": 100, "period": 60 } }
  ],
  // Live board updates: one SQLite-backed Durable Object per workspace (the free plan's kind).
  "durable_objects": { "bindings": [{ "name": "BOARD_ROOM", "class_name": "BoardRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoardRoom"] }],

  // Production is the top level above. `dev` is a separate Worker with its own database,
  // used by pull-request previews so they never touch production data.
  // Local development (`npm run dev`) uses a third, on-disk database under .wrangler/.
  "env": {
    "dev": {
      "name": "taskflow-dev",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "taskflow-dev",
          "database_id": "471c72df-8225-4e61-aff6-8826fa6994ad",
          "migrations_dir": "migrations"
        }
      ],
      "triggers": { "crons": ["0 0 * * *"] },
      "ratelimits": [
        { "name": "AUTH_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
        { "name": "VIEW_LIMITER", "namespace_id": "1004", "simple": { "limit": 100, "period": 60 } }
      ],
      "durable_objects": { "bindings": [{ "name": "BOARD_ROOM", "class_name": "BoardRoom" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoardRoom"] }]
    }
  }
}
