{
  "name": "taskflow",
  "version": "1.0.0",
  "description": "Task management app with authentication, role-based access and a Kanban board, running on Cloudflare Workers + D1.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "wrangler types --check && tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply taskflow --local",
    "db:migrate:dev": "wrangler d1 migrations apply taskflow-dev --remote --env dev",
    "db:migrate:prod": "wrangler d1 migrations apply taskflow --remote",
    "deploy:dev": "CLOUDFLARE_ENV=dev vite build && npm run db:migrate:dev && wrangler deploy",
    "deploy:prod": "vite build && npm run db:migrate:prod && wrangler deploy"
  },
  "author": "Jameson Bagain",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "hono": "^4.13.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.68.0",
    "@cloudflare/vitest-plugin": "^1.7.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  },
  "allowScripts": {
    "workerd@1.20260815.1": true,
    "workerd@1.20261103.1": true,
    "workerd@1.20261110.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
